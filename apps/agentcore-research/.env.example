# Every variable the demo reads, with a placeholder (guide 00). Copy to .env for local
# overrides; .env is gitignored. On the platform the operator injects the Temporal values.

# --- Temporal connection (agent, api, local-invoker) ---
# gRPC endpoint. Compose points the containers at temporal:7233.
TEMPORAL_ADDRESS=localhost:7233
# Namespace. The platform injects the demo's own Temporal Cloud namespace.
TEMPORAL_NAMESPACE=default
# Temporal Cloud API key. Leave empty for the local dev server.
TEMPORAL_API_KEY=
# true on Temporal Cloud.
TEMPORAL_TLS=false
# The Task Queue the agent polls and the API starts incidents on.
TEMPORAL_TASK_QUEUE=agentcore-oncall

# --- Worker Versioning (agent, local-invoker) ---
# Set by the platform for each Worker Deployment Version; the agent refuses to start without them.
TEMPORAL_DEPLOYMENT_NAME=agentcore-oncall
TEMPORAL_WORKER_BUILD_ID=local-1

# --- Agent ---
# bedrock or stub. stub is a scripted model for offline runs, labelled as such on screen.
AGENT_MODEL=stub
# Bedrock model or inference profile ID, needed with AGENT_MODEL=bedrock.
BEDROCK_MODEL_ID=
# Seconds the stub model "thinks" per call.
AGENT_STUB_DELAY_SECONDS=1.5
# Seconds with no Activity before the Worker drains and lets the AgentCore session idle out.
# Temporal's sample uses 60; Compose sets 20 so the drain is visible in a demo.
AGENTCORE_DEBOUNCE_SECONDS=60
# AWS credentials for AGENT_MODEL=bedrock locally. On AgentCore the runtime's role supplies them.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- API ---
# Listen address.
LISTEN_ADDR=:8080
# Temporal UI base and namespace for execution links. The platform sets both.
TEMPORAL_UI_URL=http://localhost:8233
TEMPORAL_UI_NAMESPACE=default
# agentcore on the platform, local under Compose; words the "starting a Worker" banner.
WORKER_LOCATION=local

# --- local-invoker (Compose only) ---
# The agent's /invocations endpoint.
AGENT_INVOKE_URL=http://agent:8080/invocations
